model UserSession {
  id              String        @id @default(uuid()) @db.Uuid
  sessionToken    String        @unique
  expiresAt       DateTime
  deviceId        String?       @db.VarChar(64)
  deviceType      String?       @db.VarChar(16)
  deviceModel     String?       @db.VarChar(64)
  osName          String?       @db.VarChar(64)
  osVersion       String?       @db.VarChar(32)
  appVersion      String?       @db.VarChar(32)
  ipAddress       String?       @db.VarChar(45)
  locationCity    String?       @db.VarChar(64)
  locationState   String?       @db.VarChar(64)
  locationCountry String?       @db.VarChar(64)
  loginAt         DateTime      @default(now())
  logoutAt        DateTime?
  sessionDuration Int?
  isActive        Boolean       @default(true)
  userRole        UserRole
  userId          String?       @db.Uuid
  professionalId  String?       @db.Uuid
  adminId         String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  admin           Admin?        @relation(fields: [adminId], references: [id], onDelete: Cascade)
  professional    Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@index([expiresAt])
  @@index([userRole])
  @@index([isActive])
  @@index([loginAt])
  @@index([userId])
  @@index([professionalId])
  @@index([adminId])
  @@map("user_sessions")
}
