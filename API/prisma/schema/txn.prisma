model Transaction {
  id              String            @id @default(uuid()) @db.Uuid
  gatewayTxnId    String?           @unique @db.VarChar(100)
  walletId        String            @db.Uuid
  amount          Int
  type            TransactionType
  status          TransactionStatus
  balanceBefore   Int?
  paymentProvider String?           @db.VarChar(64)
  description     String?
  userId          String?           @db.Uuid
  professionalId  String?           @db.Uuid
  adminId         String?           @db.Uuid
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  admin           Admin?            @relation("AdminTransactions", fields: [adminId], references: [id], onDelete: Restrict)
  professional    Professional?     @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  user            User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet          Wallet            @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([walletId, createdAt])
  @@index([userId])
  @@index([professionalId])
  @@index([adminId])
  @@index([deletedAt])
  @@map("transactions")
}
